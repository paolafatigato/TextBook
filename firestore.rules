rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // only the teacher
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['paola.fatigato@gmail.com'];
    }

    // which pages students can see: everybody reads, only the teacher writes
    match /config/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // a student's answers (and drawings): only that student
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /drawings/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Rome vs Longobards: a pupil (signed in with Google) writes and reads only his or her own heroes (heroes/<uid>_<1 or 2>);
    // the teacher reads and deletes all of them
    match /heroes/{id} {
      allow create, update: if request.auth != null && request.auth.token.email != null
        && id.matches(request.auth.uid + '_[12]') && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isTeacher() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Villain Battle online: a room is a document named with a 4-letter code.
    // Anybody signed in (even anonymously) who knows the code can read and play; nobody can list the rooms.
    match /duels/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.matches('[A-Z]{4}');
      allow update: if request.auth != null && request.resource.data.host == resource.data.host;
      allow delete: if request.auth != null;

      // Grammar Race: every player writes only their own small document (their id is a long random word)
      match /players/{pid} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
