rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // only the teacher
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['paola.fatigato@gmail.com'];
    }

    // which pages students can see: everybody reads, only the teacher writes
    match /config/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // a student's answers (and drawings): only that student
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /drawings/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Villain Battle online: a room is a document named with a 4-letter code.
    // Anybody signed in (even anonymously) who knows the code can read and play; nobody can list the rooms.
    match /duels/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && code.matches('[A-Z]{4}');
      allow update: if request.auth != null && request.resource.data.host == resource.data.host;
      allow delete: if request.auth != null;
    }
  }
}
